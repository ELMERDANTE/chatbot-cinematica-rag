# --- Credenciales ---
.env
*.key

# --- Datos ---
# Se publican: el corpus procesado (síntesis propias), la versión pública de la batería
# (sin enunciados de libros con derechos de autor), sus metadatos y el registro de verificación.
# No se publican: escaneos de libros, la batería completa y cualquier dato de estudiantes.
data/corpus/raw/
data/bateria/privado/
data/bateria/*_completa.jsonl
data/estudiantes/

# --- Ejecuciones y registros ---
experiments/runs/
*.log
logs/

# --- Índices y artefactos pesados ---
*.faiss
*.npy
*.pkl
indices/

# --- Python ---
__pycache__/
*.pyc
.venv/
venv/
.ipynb_checkpoints/

# --- Sistema ---
.DS_Store
Thumbs.db
